# =============================================================================
# Autoneural — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Two separate groups below. Everything under BROWSER is compiled into the
# JavaScript bundle and is public by design. Everything under SERVER-ONLY grants
# privileged access and must exist ONLY in the Supabase Edge Function
# environment (`supabase secrets set ...`) — never in this project's .env used
# for the frontend build, and never in a VITE_ variable.
# =============================================================================

# -----------------------------------------------------------------------------
# BROWSER (safe to expose — compiled into dist/)
# -----------------------------------------------------------------------------

# Supabase project API URL, e.g. https://abcdefghijklm.supabase.co
# Dashboard -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://uthbekvrwkgbcivsifhc.supabase.co

# Publishable / anon key. Designed to be public; it grants no table access
# because every table has RLS enabled with no policies.
# Dashboard -> Project Settings -> API Keys -> anon / publishable
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV0aGJla3Zyd2tnYmNpdnNpZmhjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg3MDU5MTcsImV4cCI6MjEwNDI4MTkxN30.H81eHmAJOvtnnytau0iqGCjjSgZT2QJ7SdibfVft4L8

# Canonical public origin, no trailing slash. Used for canonical URLs,
# Open Graph URLs and sitemap.xml. Must match the domain you serve from.
VITE_SITE_URL=https://autoneural.in


# =============================================================================
# SERVER-ONLY — set these as Supabase Edge Function secrets, NOT here.
#
#   supabase secrets set ALLOWED_ORIGINS="https://autoneural.in,https://www.autoneural.in"
#   supabase secrets set IP_HASH_SALT="$(openssl rand -hex 32)"
#
# Listed for documentation only. Do not put real values in a file that the
# frontend build can read.
# =============================================================================

# Comma-separated origin allowlist for the public Edge Functions. Requests from
# any other browser origin are rejected. Include both apex and www if both
# resolve. Leave unset only in local development.
# ALLOWED_ORIGINS=https://autoneural.in,https://www.autoneural.in

# Random secret mixed into the SHA-256 of each submitter IP, so the stored hash
# cannot be reversed by brute-forcing the (small) IPv4 space. Generate once with
# `openssl rand -hex 32` and never rotate casually — rotating invalidates all
# existing rate-limit buckets and makes historical ip_hash values incomparable.
# IP_HASH_SALT=

# Injected automatically by the Supabase platform at runtime; you do not set
# these yourself. Documented so the required permissions are obvious:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY   <- bypasses RLS. Never expose to the browser.
